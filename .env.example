# =============================================================================
#  pokekuro 設定 — このファイルだけ編集すれば全サービスが動きます
#
#    cp .env.example .env
#
# =============================================================================

# --- 外部APIキー（pipeline サービスのみが使用）--------------------------------
#  Meshy : https://www.meshy.ai/       → Settings → API Keys
#  Gemini: https://aistudio.google.com/apikey
#
#  未設定でも起動はできますが、服の3D生成（/api/fitting-jobs）が
#  「GEMINI_API_KEY が設定されていません」等のエラーで失敗します。
#  設定状況は http://localhost:8001/... ではなく pipeline の /health で確認できます:
#    docker compose exec pipeline python -c \
#      "import urllib.request;print(urllib.request.urlopen('http://localhost:9000/health').read())"
MESHY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# --- DB ----------------------------------------------------------------------
POSTGRES_USER=pokekuro
POSTGRES_PASSWORD=pokekuro
POSTGRES_DB=pokekuro

# --- 認証 --------------------------------------------------------------------
#  本番では必ず変更する: openssl rand -hex 32
JWT_SECRET=dev-secret

# --- 公開ポート（他プロセスと衝突する場合のみ変更）------------------------------
API_PORT=8001
#  5432 は Postgres が入っているマシンだと塞がっており、compose up が
#  丸ごと失敗するため既定値をずらしてある。
DB_PORT=55432

# --- 開発PCの LAN IP（実機で開く場合は必須）------------------------------------
#  実機の Expo Go は localhost では開発PCに到達できないため、QR にこの IP を
#  埋める必要がある。コンテナ側からホストの LAN IP は取得できないので、
#  ここに手で書く。
#
#  調べ方:
#    macOS  ipconfig getifaddr en0
#    Linux  hostname -I | awk '{print $1}'
#    Windows  ipconfig      （「IPv4 アドレス」）
#
#  値はコンテナ生成時に固定される。Wi-Fi を変えるなどで IP が変わったら
#  ここを書き換えて docker compose --profile mobile up -d をやり直すこと
#  （古いままだと expo の起動ログが警告する）。
HOST_IP=
