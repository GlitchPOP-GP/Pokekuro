# =============================================================================
#  pokekuro 設定 — このファイルだけ編集すれば全サービスが動きます
#
#    cp .env.example .env
#
# =============================================================================

# --- 外部APIキー（pipeline サービスのみが使用）--------------------------------
#  Meshy : https://www.meshy.ai/       → Settings → API Keys
#  Gemini: https://aistudio.google.com/apikey
#
#  未設定でも起動はできますが、服の3D生成（/api/fitting-jobs）が
#  「GEMINI_API_KEY が設定されていません」等のエラーで失敗します。
#  設定状況は http://localhost:8001/... ではなく pipeline の /health で確認できます:
#    docker compose exec pipeline python -c \
#      "import urllib.request;print(urllib.request.urlopen('http://localhost:9000/health').read())"
MESHY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# --- DB ----------------------------------------------------------------------
POSTGRES_USER=pokekuro
POSTGRES_PASSWORD=pokekuro
POSTGRES_DB=pokekuro

# --- 認証 --------------------------------------------------------------------
#  本番では必ず変更すること: openssl rand -hex 32
JWT_SECRET=dev-secret

# --- 公開ポート（他プロセスと衝突する場合のみ変更）------------------------------
API_PORT=8001
WEB_PORT=8080
DB_PORT=5432

# --- 実機開発（--profile mobile）のみ -----------------------------------------
#  通常は `npm run dev` が LAN IP を自動検出して渡すため記入不要。
#  VPN・複数NIC 等で自動検出が誤る場合だけ手動で指定する。
# HOST_IP=192.168.1.10
