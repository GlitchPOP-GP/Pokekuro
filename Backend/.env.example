POSTGRES_USER=pokekuro
POSTGRES_PASSWORD=pokekuro
POSTGRES_DB=pokekuro

# ホスト側（docker外）から接続する場合の接続文字列
DATABASE_URL=postgresql://pokekuro:pokekuro@localhost:5432/pokekuro

JWT_SECRET=dev-secret
PORT=8001

# 服の3D生成パイプライン用（各サービスのAPIキーを設定）
MESHY_API_KEY=
GEMINI_API_KEY=

# FittingPipeline（旧 yzl3Dmodel、Python + Blender）のルート
PIPELINE_ROOT=C:\path\to\FittingPipeline
PYTHON_PATH=python
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.0\blender.exe
