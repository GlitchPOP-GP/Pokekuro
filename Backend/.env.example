# このファイルは Backend を docker 外で単体起動する場合にのみ使う。
# docker compose で動かす場合はリポジトリルートの .env が唯一の設定元になるため、
# ここを編集する必要はない。
#
# APIキー（MESHY / GEMINI）はここには置かない。pipeline サービスだけが保持する。

POSTGRES_USER=pokekuro
POSTGRES_PASSWORD=pokekuro
POSTGRES_DB=pokekuro

# ホスト側（docker外）から接続する場合の接続文字列
DATABASE_URL=postgresql://pokekuro:pokekuro@localhost:5432/pokekuro

JWT_SECRET=dev-secret
PORT=8001

# 服の3D生成を担う FittingPipeline サービスの URL。
# docker compose では http://pipeline:9000 が自動で入る。
PIPELINE_URL=http://localhost:9000
