# このファイルは FittingPipeline を docker 外で単体実行する場合にのみ使う。
# docker compose で動かす場合はリポジトリルートの .env が唯一の設定元になる。

MESHY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# 省略時は PATH / OS ごとの既定パスから自動検出する（scripts/blender_env.py）
BLENDER_PATH=

# GPU が無い環境（コンテナ等）では CYCLES を指定する。
# 省略時は EEVEE → CYCLES の順に試す。検証レンダリング用の設定。
POKEKURO_RENDER_ENGINE=
