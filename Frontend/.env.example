# バックエンド API のベースURL（Expo は EXPO_PUBLIC_ 接頭辞の変数を自動でバンドルする）
#
# ⚠ EXPO_PUBLIC_* はクライアントバンドルに埋め込まれ、配布後は誰でも読み取れる。
#    APIキーの類は絶対にここへ書かないこと（pipeline サービスにのみ持たせる）。
#
# ・Expo Web / iOSシミュレータ / Androidエミュレータ: localhost で到達可能
#     EXPO_PUBLIC_API_URL=http://localhost:8001
# ・実機（Expo Go）: PC の LAN IP を指定する（localhost は端末自身を指すため）
#     EXPO_PUBLIC_API_URL=http://192.168.x.x:8001
# ・Web版イメージ（Dockerfile.web）: "/" ＝同一オリジン。nginx が api にプロキシする。
#
# docker 経由（npm run dev）では start.mjs が HOST_IP を解決し、
# ルートの docker-compose.yaml が EXPO_PUBLIC_API_URL=http://${HOST_IP}:8001 を渡す。
EXPO_PUBLIC_API_URL=http://localhost:8001
