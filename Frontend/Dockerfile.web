# Expo Web の静的ビルドを nginx で配信する（提出・デモ用）。
# ネイティブアプリ（.apk / .ipa）はこの経路では作れないため EAS Build を使う。

FROM node:20-bookworm AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# "/" は「同一オリジン」を意味する。nginx が /api などを api コンテナへ
# プロキシするため、LAN IP（HOST_IP）に依存しなくなる。
# ※ EXPO_PUBLIC_* はクライアントバンドルに埋め込まれる。APIキーは絶対に置かないこと。
ENV EXPO_PUBLIC_API_URL=/

RUN npx expo export --platform web --output-dir dist

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
